// LeetCode -> 85. Maximal Rectangle

class Solution {
public:
    int largestRectArea(vector<int>& matrix){
        stack<int>st;
        int maxArea = 0;
        for(int i= 0;i<matrix.size();i++){
            while(!st.empty() && matrix[st.top()]>matrix[i]){
                int ele = matrix[st.top()];
                st.pop();
                int psi = st.empty()?-1:st.top();
                int nsi = i;
                int area = ele*(nsi-psi-1);
                maxArea = max(maxArea,area);
            }
            st.push(i);
        }
        while(!st.empty()){
            int ele = matrix[st.top()];
            st.pop();
            int nsi = matrix.size();
            int psi = st.empty()?-1:st.top();
            int area = ele*(nsi-psi-1);
            maxArea = max(maxArea,area);
        }
        return maxArea;
    }
    int maximalRectangle(vector<vector<char>>& matrix) {
        int n = matrix.size();
        int m = matrix[0].size();
        int maxArea = 0;
        vector<int>height(m,0);
        for(int i =0;i<n;i++){
            for(int j = 0;j<m;j++){
                if(matrix[i][j] == '1'){
                    height[j]++;
                }
                else{
                    height[j] = 0; 
                }
            }
            int area= largestRectArea(height);
            maxArea = max(maxArea,area);
        }
        return maxArea;
    }
};
