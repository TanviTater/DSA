// LeetCode ->11. Container With Most Water

class Solution {
public:
    int maxArea(vector<int>& height) {
        int l =0;
        int r = height.size()-1;
        int maxWater = 0;
        while(l<=r){
            if(height[l] <= height[r]){
                int area = height[l]*(r-l);
                maxWater = max(maxWater,area);
                l++;
            }
            else{
                int area = height[r]*(r-l);
                maxWater = max(maxWater,area);
                r--;
            }
        }
        return maxWater;
    }
};
