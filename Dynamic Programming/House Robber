// LeetCode -> 198. House Robber

class Solution {
public:
int solve(int i,vector<int>&nums){
    if(i== 0) return nums[i];
    if(i< 0) return 0;
    int incl = nums[i]+solve(i-2,nums);
    int excl = solve(i-1,nums);
    return max(incl,excl);
}
int solveMem(int i,vector<int>&nums,vector<int>&dp){
    if(i == 0) return nums[i];
    if(i<0) return 0;
    if(dp[i] != -1) return dp[i];
    int incl = nums[i] + solveMem(i-2,nums,dp);
    int excl = solveMem(i-1,nums,dp);
    return dp[i] = max(incl,excl);
}
    int rob(vector<int>& nums) {
        int n = nums.size()-1;
        // return solve(n,nums);
        vector<int>dp(n+1,-1);
        return solveMem(n,nums,dp);
    }
};
