// LeetCode -> 542. 01 Matrix

using pi = pair<int,int>;
using pii = pair<int,pi>;
class Solution {
public:
    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {
        int m = mat.size();
        int n = mat[0].size();
        vector<vector<int>>dist(m,vector<int>(n,0));
        queue<pii>pq;
        for(int i =0;i<m;i++){
            for(int j = 0;j<n;j++){
                if(mat[i][j] == 0){
                    
                    dist[i][j] = 0;
                    pq.push({0,{i,j}});
                }
            }
        }
        vector<pi>dirs = {{0,1},{0,-1},{1,0},{-1,0}};
        while(!pq.empty()){
            auto it = pq.front();
            pq.pop();
            int distance =  it.first;
            int row = it.second.first;
            int col = it.second.second;
            for(int i =0;i<4;i++){
                int newR = row+dirs[i].first;
                int newC = col+dirs[i].second;
                if(newR>=0 && newC >=0 && newR < m && newC < n){
                    if(mat[newR][newC] == 1){
                        int diff = abs(newR-row)+abs(newC-col);
                        int d = distance+diff;
                        mat[newR][newC] = 0;
                        dist[newR][newC] = d;
                        pq.push({d,{newR,newC}});
                    }
                }
            }
        }
        return dist;
    }
};
