// LeetCode -> 207. Course Schedule

class Solution {
    bool dfs(int node,vector<int>&visited,unordered_map<int,vector<int>>&adj,stack<int>&st, vector<int>&currVisiting){
        visited[node] = 1;
        currVisiting[node] = 1;
        bool ans = true;
        for(auto it:adj[node]){
            if(!visited[it]){
                ans = dfs(it,visited,adj,st,currVisiting);
                if(!ans) return ans;
            }
            else if(currVisiting[it]){
                return ans = false;
            }
            else{
                continue;
            }
        }
        st.push(node);
        currVisiting[node] = 0;
        return ans;
    }

    bool topoSort(int numCourses, vector<vector<int>>& prerequisites){
        unordered_map<int,vector<int>>adj;
        for(auto p :prerequisites){
            adj[p[1]].push_back(p[0]);
        }
        vector<int>visited(numCourses,0);
        vector<int>currVisiting(numCourses,0);
        stack<int>st;
        bool ans = true;
        for(int i =0;i<numCourses;i++){
            if(!visited[i]){
                ans = dfs(i,visited,adj,st,currVisiting);
                if(!ans) return ans;
            }
        }
        return ans;
    }
public:
    bool canFinish(int numCourses, vector<vector<int>>& prerequisites) {
        return topoSort(numCourses,prerequisites);
    }
};
