// LeetCode -> 102. Binary Tree Level Order Traversal

class Solution {
public:
    vector<vector<int>> levelOrder(TreeNode* root) {
        if(root == NULL) return {};
        vector<vector<int>>ans;
        queue<TreeNode*>q;
        q.push(root);
        while(!q.empty()){
            vector<int>temp;
            int size = q.size();
            for(int i =0;i<size;i++){
                TreeNode* front = q.front();
                q.pop();
                if(front -> left){
                    q.push(front->left);
                }
                if(front -> right){
                    q.push(front->right);
                }
                temp.push_back(front->val);
            }
            ans.push_back(temp);
        }
        return ans;
    }
};
