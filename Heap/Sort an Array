// LeetCode -> 912. Sort an Array

class Solution {
public:
    vector<int> sortArray(vector<int>& nums) {
        // sort(nums.begin(),nums.end());
        // return nums;
        vector<int>ans;
        priority_queue<int,vector<int>,greater<int>>pq;
        for(int num:nums){
            pq.push(num);
        }
        while(!pq.empty()){
            ans.push_back(pq.top());
            pq.pop();
        }
        return ans;
    }
};
