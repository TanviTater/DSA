// LeetCode -> 63. Unique Paths II

class Solution {
public:
    int solve(vector<vector<int>>&grid,int m,int n,int i,int j){
        if(i == m-1 && j == n-1) return 1;
        if(i >= m || j >= n) return 0;
        if(grid[i][j] == 1) return 0;
        int down = 0;
        int right = 0;
        if(i<m){
            right += solve(grid,m,n,i+1,j);
        }
        if(j<n){
            down += solve(grid,m,n,i,j+1);
        }
        return right + down;
    }
    int solveMem(vector<vector<int>>&grid,int m,int n,int i,int j,vector<vector<int>>&dp){
        if(i == m-1 && j == n-1) return 1;
        if(i >= m || j >= n) return 0;
        if(grid[i][j] == 1) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        int right= 0;
        int down = 0;
        if(i < m){
            right += solveMem(grid,m,n,i+1,j,dp);
        }
        if(j < n){
            down += solveMem(grid,m,n,i,j+1,dp);
        }
        return dp[i][j] = down + right;
    }
    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int m = obstacleGrid.size();
        int n = obstacleGrid[0].size();
        // return solve(obstacleGrid,m,n,0,0);
        if(obstacleGrid[m-1][n-1] == 1) return 0;
        vector<vector<int>>dp(m+1,vector<int>(n+1,-1));
        return solveMem(obstacleGrid,m,n,0,0,dp);
    }
};
