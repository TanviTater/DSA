// LeetCode -> 5. Longest Palindromic Substring
class Solution {
public:
bool isPossible(int i,int j,const string &s){
    while(i<=j){
        if(s[i] != s[j]){
            return false;
        }
        i++;
        j--;
    }
    return true;
}
    string longestPalindrome(string s) {
        int maxLen = 0;
        int start = 0;
        for(int i =0;i<s.size();i++){
            int j = s.size()-1;
            while(i<=j){
                int len=0;
                if(isPossible(i,j,s)){
                    len = j - i + 1;
                    if(len > maxLen) {
                        maxLen = len;
                        start = i;
                    }
                }
                j--;
            }
        }
        return s.substr(start,maxLen);
    }
};



// Optimised -> tc =O(n^2)

class Solution {
public:
    string longestPalindrome(string s) {
        string ans = "";
        int maxLen = 0;
        int start = 0;
        int end  =0;
        int n = s.size();
        if(s.size()<1)return ans;
        for(int i = 0;i<s.size();i++){
            int left = i;
            int right = i;
            while(left>=0 && right<n && s[left] == s[right]){
                int len = right-left+1;
                if(len>maxLen){
                    maxLen = len;
                    start = left;
                    end = right;
                }
                left--;
                right++;
            }
            left = i;
            right = i+1;
            while(left>=0 && right<n && s[left] == s[right]){
                int len = right-left+1;
                if(len>maxLen){
                    maxLen = len;
                    start = left;
                    end = right;
                }
                left--;
                right++;
            }
        }
        return s.substr(start,maxLen);
    }
};
