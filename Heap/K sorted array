// GeeksForGeeks -> k sorted array

class Solution {
  public:
    string isKSortedArray(int arr[], int n, int k) {
        priority_queue<pair<int,int>,vector<pair<int,int>>,greater<pair<int,int>>>pq;
        for(int i =0;i<n;i++){
            pq.push({arr[i],i});
        }
        int i =0;
        while(!pq.empty()){
            int num = pq.top().first;
            int idx = pq.top().second;
            pq.pop();
            int diff = idx-i;
            if(abs(idx-i)>k ){
                return "No";
            }
            i++;
        }
        return "Yes";
    }
};
