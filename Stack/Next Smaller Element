// GFG -> Next Smaller Element
class Solution {
  public:
    vector<int> nextSmallerEle(vector<int>& arr) {
        vector<int>nse;
        stack<int>st;
        int n =arr.size();
        for(int i =n-1;i>=0;i--){
            while(!st.empty() && st.top()>=arr[i]){
                st.pop();
            }
            if(st.empty()){
                nse.push_back(-1);
            }
            else{
                nse.push_back(st.top());
            }
            st.push(arr[i]);
        }
        reverse(nse.begin(),nse.end());
        return nse;
    }
};
