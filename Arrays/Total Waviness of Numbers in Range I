// Leetcode -> 3751. Total Waviness of Numbers in Range I
class Solution {
public:
    vector<int> digitsOf(int num) {
        vector<int> digits;
        while (num > 0) {
            digits.push_back(num % 10);
            num /= 10;
        }
        reverse(digits.begin(), digits.end());
        return digits;
    }
    int totalWaviness(int num1, int num2) {
        if (num1 < 100 && num2 < 100) {
            return 0;
        }
        int waviness = 0;
        vector<vector<int>> result;
        if(num1<100){
            num1 = 100;
        }
        for (int i = num1; i <= num2; i++) {
            result.push_back(digitsOf(i));
        }

        for (int j = 0; j < result.size(); j++) {
            for (int i = 1; i < result[j].size()-1; i++) {
                if (result[j][i] > result[j][i - 1] && result[j][i] > result[j][i + 1]) {
                    waviness++;
                } else if (result[j][i] < result[j][i - 1] && result[j][i] < result[j][i + 1]) {
                    waviness++;
                }
            }
        }
        return waviness;
    }
};
