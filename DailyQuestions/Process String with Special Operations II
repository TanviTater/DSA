// LeetCode -> 3614. Process String with Special Operations II

class Solution {
public:
    char processStr(string s, long long k) {
        long long length = 0;
        for(int i =0;i<s.size();i++){
            if(s[i] >= 'a' && s[i] <= 'z'){
                length++;
            }
            else if(s[i] == '#'){
                length *= 2;
            }
            else if(s[i] == '*'){
                if(length > 0) length--;
            }
            else continue;
        }
        if(k>=length) return '.';
        for(int i = s.size()-1 ;i >= 0 ;i--){
            if(s[i] >= 'a' && s[i] <= 'z'){
                length--;
                if(length == k){
                    return s[i];
                }
            }
            else if(s[i] == '#'){
                length /= 2;
                if(k>=length){
                    k = k - length;
                }
            }
            else if(s[i] == '%'){
                k = length - k - 1;
            }
            else{
                length ++;
            }
        }
        return '.';
    }
};
