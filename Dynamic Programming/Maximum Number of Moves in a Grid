// LeetCode -> 2684. Maximum Number of Moves in a Grid

class Solution {
public:
    int solve(vector<vector<int>>& grid,int i,int j,int m,int n){
        if(i>=m|| j>=n) return 0;
        int up =0;
        int side = 0;
        int down = 0;
        if(i-1>=0 && j+1<n){
            if(grid[i][j]< grid[i-1][j+1]){
                up = 1+solve(grid,i-1,j+1,m,n);
            }
        }
        if(j+1<n){
            if(grid[i][j]<grid[i][j+1]){
                side =1+ solve(grid,i,j+1,m,n);
            }
        }
        if(i+1<m && j+1<n){
            if(grid[i][j] < grid[i+1][j+1]){
                down =1+ solve(grid,i+1,j+1,m,n);
            }
        }
        return max({up,side,down});
    }
    int solveMem(vector<vector<int>>& grid,int i,int j,int m,int n, vector<vector<int>>&dp){
        if(i>=m|| j>=n) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        int up =0;
        int side = 0;
        int down = 0;
        if(i-1>=0 && j+1<n){
            if(grid[i][j]< grid[i-1][j+1]){
                up = 1+solveMem(grid,i-1,j+1,m,n,dp);
            }
        }
        if(j+1<n){
            if(grid[i][j]<grid[i][j+1]){
                side =1+ solveMem(grid,i,j+1,m,n,dp);
            }
        }
        if(i+1<m && j+1<n){
            if(grid[i][j] < grid[i+1][j+1]){
                down =1+ solveMem(grid,i+1,j+1,m,n,dp);
            }
        }
        return dp[i][j] = max({up,side,down});
    }
    int maxMoves(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();
        // int ans = INT_MIN;
        // for(int j = 0;j<m;j++){
        //     ans = max(ans,solve(grid,j,0,m,n));
        // }
        // return ans;
        vector<vector<int>>dp(m+1,vector<int>(n+1,-1));
        int ans = INT_MIN;
        for(int j = 0;j<m;j++){
            ans = max(ans,solveMem(grid,j,0,m,n,dp));
        }
        return ans;
    }
};
