// LeetCode -> 64. Minimum Path Sum

class Solution {
public:
    int solve(vector<vector<int>>& grid,int i,int j){
        if(i == grid.size()-1 && j == grid[0].size()-1){
            return grid[i][j];
        }
        if(i >= grid.size() || j >= grid[0].size()){
            return INT_MAX;
        }
        int right = solve(grid,i+1,j);
        int down = solve(grid,i,j+1);
        return grid[i][j]+min(right,down);
    }
    int solveMem(vector<vector<int>>&grid,int i,int j,vector<vector<int>>&dp){
        if(i == grid.size()-1 && j == grid[0].size()-1){
            return grid[i][j];
        }
        if(i >= grid.size() || j >= grid[0].size()){
            return INT_MAX;
        }
        if(dp[i][j] != -1) return dp[i][j];
        int right = solveMem(grid,i+1,j,dp);
        int down = solveMem(grid,i,j+1,dp);
        return dp[i][j] = grid[i][j] + min(right,down);
    }
    int minPathSum(vector<vector<int>>& grid) {
        // return solve(grid,0,0);
        int n = grid.size();
        int m = grid[0].size();
        vector<vector<int>>dp(n+1,vector<int>(m+1,-1));
        return solveMem(grid,0,0,dp);
    }
};
