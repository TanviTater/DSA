// LeetCode -> 1423. Maximum Points You Can Obtain from Cards

class Solution {
public:
    int maxScore(vector<int>& cardPoints, int k) {
        int sum =0;
        int maxSum =0;
        for(int i =0;i<k;i++){
            sum+=cardPoints[i];
        }
        maxSum = sum;
        int left = k-1;
        int right = cardPoints.size()-1;
        while(left>=0 && right>=0){
            sum-=cardPoints[left--];
            sum+=cardPoints[right--];
            maxSum = max(maxSum,sum);
        }
        return maxSum;
    }
};
