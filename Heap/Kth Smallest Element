// Coding Ninjas -> Kth Smallest Element

int kthSmallest(int n,int k,vector<int> arr)
{
    priority_queue<int>pq;
    for(int i =0;i<n;i++){
        if(pq.size()<k){
            pq.push(arr[i]);
        }
        else{
            if(pq.top()>arr[i]){
                pq.pop();
                pq.push(arr[i]);
            }
        }
    }
    return pq.top();
}
