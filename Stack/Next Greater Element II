// LeetCode -> 503. Next Greater Element II

class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        vector<int>nge;
        stack<int>st;
        int n = nums.size();
        for(int i = n-1;i>=0;i--){
            while(!st.empty() && st.top()<=nums[i]){
                st.pop();
            }
            if(st.empty()){
                nge.push_back(-1);
            }
            else{
                nge.push_back(st.top());
            }
            st.push(nums[i]);
        }
        reverse(nge.begin(),nge.end());
        for(int i =0;i<n;i++){
            if(nge[i] == -1){
                for(int j = i+1;j<i+n;j++){
                    int idx = j%n;
                    if(nums[idx]>nums[i]){
                        nge[i] = nums[idx];
                        break;
                    }
                }
            }
        }
        return nge;
    }
};


class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n =nums.size();
        vector<int>nge(n);
        stack<int>st;
        for(int i = 2*n-1;i>=0;i--){
            while(!st.empty() && st.top()<=nums[i%n]){
                st.pop();
            }
            if(i<n){
                nge[i] = st.empty()?-1:st.top();
            }
            st.push(nums[i%n]);
        }
        return nge;
    }
};

