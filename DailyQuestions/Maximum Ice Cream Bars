// LeetCode -> 1833. Maximum Ice Cream Bars

class Solution {
public:
    int maxIceCream(vector<int>& costs, int coins) {
        sort(costs.begin(),costs.end());
        int canBuy = 0;
        for(int i =0;i<costs.size();i++){
            if(costs[i]<=coins){
                canBuy+=1;
                coins-=costs[i];
            }
            else{
                break;
            }
        }
        return canBuy;
    }
};
