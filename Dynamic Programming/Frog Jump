// GeeksForGeeks -> Frog Jump

class Solution {
  public:
    int solve(vector<int>& height,int n){
        if(n == 0) return 0;
        if(n < 0) return 0;
        int one = abs(height[n]-height[n-1])+solve(height,n-1);
        int two = INT_MAX;
        if(n>1){
            two = abs(height[n]-height[n-2])+solve(height,n-2);
        }
        return min(one,two);
    }
    int solveMem(vector<int>&height,int n,vector<int>&dp){
        if(n<=0) return 0;
        if(dp[n] != -1) return dp[n];
        int one = abs(height[n]-height[n-1])+solveMem(height,n-1,dp);
        int two = INT_MAX;
        if(n>1){
            two = abs(height[n]-height[n-2])+solveMem(height,n-2,dp);
        }
        return dp[n] = min(one,two);
    }
    int minCost(vector<int>& height) {
        int n = height.size()-1;
        // return solve(height,n);
        vector<int>dp(n+2,-1);
        return solveMem(height,n,dp);
    }
};
