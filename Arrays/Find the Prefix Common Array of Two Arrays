// LeetCode -> 2657. Find the Prefix Common Array of Two Arrays
class Solution {
public:
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
        vector<int>c;
        unordered_map<int,int>a;
        for(int i = 0;i<A.size();i++){
            int count =0;
            a[A[i]]++;
            a[B[i]]++;
            for(auto num:a){
                if(num.second>=2){
                    count++;
                }
            }
            c.push_back(count);
        }
        return c;
    }
};
