// LeetCode -> 3. Longest Substring Without Repeating Characters
class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int len = 0;
        unordered_map<char,int>mp;
        int j =0;
        for(int i =0;i<s.size();i++){
            mp[s[i]]++;
            while(mp[s[i]]>1){
                mp[s[j]]--;
                j++;
            }
            len = max(len,i-j+1);
        }
        return len;
    }
};
