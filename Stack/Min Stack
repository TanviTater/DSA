// LeetCode -> 155. Min Stack

class MinStack {
public:
stack<int>st;
stack<int>minStack;
    MinStack() {
    }
    
    void push(int value) {
        st.push(value);
        if(!minStack.empty()){
            if(minStack.top()<value){
                minStack.push(minStack.top());
            }
            else{
                minStack.push(value);
            }
        }
        else{
            minStack.push(value);
        }
    }
    
    void pop() {
        if(!st.empty()) st.pop();
        if(!minStack.empty()) minStack.pop();
    }
    
    int top() {
        return st.top();
    }
    
    int getMin() {
        return minStack.top();
    }
};

