// GeeksForGeeks -> Minimum Cost of ropes

class Solution {
  public:
    int minCost(vector<int>& arr) {
        int ans = 0;
        priority_queue<int,vector<int>,greater<int>>pq;
        for(int num:arr){
            pq.push(num);
        }
        while(pq.size()!=1){
            int cost = 0;
            cost+=pq.top();
            pq.pop();
            if(!pq.empty()){
                cost+=pq.top();
                pq.pop();
            }
            ans+=cost;
            pq.push(cost);
        }
        return ans;
    }
};
