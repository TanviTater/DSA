// LeetCode -> 209. Minimum Size Subarray Sum

class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int s = 0;
        int sum = 0;
        int minLen = INT_MAX;
        for(int i = 0;i<nums.size();i++){
            sum += nums[i];
            while(sum >= target){
                sum -= nums[s];
                minLen  = min(minLen , i - s +1);
                s++;
            }
        }
        if(minLen == INT_MAX) return 0;
        return minLen;
    }
};
