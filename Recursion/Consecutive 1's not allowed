// GFG -> Consecutive 1's not allowed

class Solution {
    int solve(int n,int i,bool one,vector<vector<int>>&dp){
        if(i == n){
            return 1;
        }
        if(dp[i][one] != -1) return dp[i][one];
        int cnt = 0;
        if(!one){
            cnt += solve(n,i+1,true,dp);
        }
        cnt+=solve(n,i+1,false,dp);
        return dp[i][one] = cnt;
    }
  public:
    int countStrings(int n) {
        bool one = false;
        vector<vector<int>>dp(n+1,vector<int>(2,-1));
        return solve(n,0,one,dp);
    }
};
