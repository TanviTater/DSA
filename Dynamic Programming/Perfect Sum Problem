// GeeksForGeeks -> Perfect Sum Problem

using v = vector<int>;
using vv = vector<v>;
class Solution {
  public:
    int solve(vector<int>& arr,int target,int i){
        if(i == arr.size()) return target == 0;
        if(i>arr.size() || target < 0) return 0;
        int incl = solve(arr,target-arr[i],i+1);
        int excl = solve(arr,target,i+1);
        return incl + excl;
    }
    int solveMem(vector<int>& arr,int target,int i,vv &dp){
        if(i == arr.size()) return target == 0;
        if(i > arr.size() || target < 0) return 0;
        if(dp[target][i] != -1) return dp[target][i];
        int incl = solveMem(arr,target-arr[i],i+1,dp);
        int excl = solveMem(arr,target,i+1,dp);
        return dp[target][i] = incl + excl;
    }
    int perfectSum(vector<int>& arr, int target) {
        // return solve(arr,target,0);
        int n = arr.size();
        vv dp(target+1,v(n+1,-1));
        return solveMem(arr,target,0,dp);
    }
};
