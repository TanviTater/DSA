// LeetCode -> 1004. Max Consecutive Ones III
class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int maxLen = 0;
        unordered_map<int,int>mp;
        int left = 0;
        for(int i =0;i<nums.size();i++){
            mp[nums[i]]++;
            if(nums[i] == 0){
                k--;
            }
            while(k<0){
                if(nums[left] == 0){
                    k++;
                }
                left++;
            }
            maxLen = max(maxLen,i-left+1);
        }
        return maxLen;
    }
};
