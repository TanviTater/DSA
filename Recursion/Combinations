// LeetCode -> 77. Combinations
class Solution {
public:
void solve(int n,int k,vector<vector<int>>&ans,vector<int>&temp,int kk,int i){
    if(kk == k){
        ans.push_back(temp);
        return ;
    }
    for(int j =i;j<=n;j++){
        temp.push_back(j);
        solve(n,k,ans,temp,kk+1,j+1);
        temp.pop_back();
    }
}
    vector<vector<int>> combine(int n, int k) {
        vector<vector<int>>ans;
        vector<int>temp;
        solve(n,k,ans,temp,0,1);
        return ans;
    }
};
