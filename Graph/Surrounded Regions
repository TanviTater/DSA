// LeetCode -> 130. Surrounded Regions

class Solution {
    void dfs(int i,int j,vector<vector<char>>&board){
        board[i][j] = '*';
        vector<pair<int,int>>dirs = {{0,1},{0,-1},{1,0},{-1,0}};
        for(int I =0;I<4;I++){
            int newR = i + dirs[I].first;
            int newC = j + dirs[I].second;
            if(newR >= 0 && newC >= 0 && newR < board.size() && newC < board[0].size()){
                if(board[newR][newC] == 'O'){
                    dfs(newR,newC,board);
                }
            }
        }
    }
public:
    void solve(vector<vector<char>>& board) {
        int m = board.size();
        int n = board[0].size();
        for(int i =0;i<m;i++){
            if(board[i][0] == 'O'){
                dfs(i,0,board);
            }
            if(board[i][n-1] == 'O'){
                dfs(i,n-1,board);
            }
        }
        for(int i =0;i<n;i++){
            if(board[0][i] == 'O'){
                dfs(0,i,board);
            }
            if(board[m-1][i] == 'O'){
                dfs(m-1,i,board);
            }
        }
        for(int i =0;i<m;i++){
            for(int j =0;j<n;j++){
                if(board[i][j] == '*'){
                    board[i][j] = 'O';
                }
                else{
                    board[i][j] = 'X';
                }
            }
        }
    }
};
