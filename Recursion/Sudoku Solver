// LeetCode -> 37. Sudoku Solver
class Solution {
public:
bool isPossible(int i,int j,vector<vector<char>>&board,char val){
    int n = board.size();
    for(int r =0;r<n;r++){
        if(board[r][j] == val) return false;
    }
    for(int c = 0;c<n;c++){
        if(board[i][c] == val) return false;
    }
    for(int m =0;m<n;m++){
        int r = 3*(i/3)+m/3;
        int c = 3*(j/3)+m%3;
        if(board[r][c] == val) return false;
    }
    return true;
}
bool solve(vector<vector<char>>& board){
    int n = board.size();
    for(int i =0;i<n;i++){
        for(int j =0;j<n;j++){
            if(board[i][j] == '.'){
                for(char k ='1';k<='9';k++){
                    if(isPossible(i,j,board,k)){
                        board[i][j] = k;
                        if(solve(board))
                            return true;
                        board[i][j] = '.';
                    }
                }
                return false;
            }
        }
    }
    return true;
}
    void solveSudoku(vector<vector<char>>& board) {
        solve(board);
    }
};
