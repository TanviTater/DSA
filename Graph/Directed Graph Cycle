// GeeksForGeeks -> Directed Graph Cycle

class Solution {
    bool dfs(int node,unordered_map<int,vector<int>>&adj,vector<int>&visited,vector<int>&currVisiting){
        visited[node]=1;
        currVisiting[node] = 1;
        bool ans = false;
        for(auto it:adj[node]){
            if(!visited[it]){
                ans = dfs(it,adj,visited,currVisiting);
                if(ans) return ans;
            }
            else if(visited[it] == 1 && currVisiting[it]){
                return ans = true;
            }
            else continue;
        }
        currVisiting[node] = 0;
        return ans;
    }
  public:
    bool isCyclic(int V, vector<vector<int>> &edges) {
        unordered_map<int,vector<int>>adj;
        for(auto e:edges){
            adj[e[0]].push_back(e[1]);
        }
        vector<int>visited(V,0);
        vector<int>currVisiting(V,0);
        bool ans = false;
        for(int i =0;i<V;i++){
            if(!visited[i]){
                ans = dfs(i,adj,visited,currVisiting);
                if(ans) return true;
            }
        }
        return ans;
    }
};
