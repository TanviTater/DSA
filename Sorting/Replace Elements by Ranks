// GeeksForGeeks -> Replace Elements by Ranks

class Solution {
  public:
    void replaceWithRank(vector<int>& arr) {
        vector<pair<int,int>>v;
        int n = arr.size();
        for(int i =0;i<n;i++){
            v.push_back({arr[i],i});
        }
        sort(v.begin(),v.end());
        vector<int> rank(n);
        for (int i = 0; i < n; i++) {
            rank[v[i].second] = i;
        }
        arr = rank;
    }
};
