// LeetCode -> 1020. Number of Enclaves

class Solution {
    void dfs(int i,int j,vector<vector<int>>&grid){
        grid[i][j] = '*';
        vector<pair<int,int>>dirs = {{0,1},{0,-1},{1,0},{-1,0}};
        for(int idx =0;idx<4;idx++){
            int newR = i + dirs[idx].first;
            int newC = j + dirs[idx].second;
            if(newR >= 0 && newC >= 0 && newR < grid.size() && newC < grid[0].size()){
                if(grid[newR][newC] == 1){
                    dfs(newR,newC,grid);
                }
            }
        }
    }
public:
    int numEnclaves(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();
        for(int i =0;i<m;i++){
            if(grid[i][0] == 1) dfs(i,0,grid);
            if(grid[i][n-1]==1) dfs(i,n-1,grid);
        }
        for(int j =0;j<n;j++){
            if(grid[0][j] == 1) dfs(0,j,grid);
            if(grid[m-1][j]==1) dfs(m-1,j,grid);
        }
        int count = 0;
        for(int i =0;i<m;i++){
            for(int j =0;j<n ;j++){
                if(grid[i][j] == 1) count++;
            }
        }
        return count;
    }
};
