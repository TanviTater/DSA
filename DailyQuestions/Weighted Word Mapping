// LeetCode -> 3838. Weighted Word Mapping

class Solution {
public:
    string mapWordWeights(vector<string>& words, vector<int>& weights) {
        string ans = "";
        for(int  i=0;i<words.size();i++){
            int count =0;
            for(int j= 0;j<words[i].size();j++){
                count+=weights[words[i][j]-'a'];
            }
            count = count%26;
            ans.push_back('z'-count);
        }
        return ans;
    }
};
