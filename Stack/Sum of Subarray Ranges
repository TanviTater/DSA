//LeetCode -> 2104. Sum of Subarray Ranges
class Solution {
public:
    long long subArrayRanges(vector<int>& nums) {
        vector<int>nge;
        vector<int>pge;
        vector<int>pse;
        vector<int>nse;
        stack<int>st;
        stack<int>st2;
        stack<int>st3;
        stack<int>st4;
        int n = nums.size();
        for(int i= nums.size()-1;i>=0;i--){
            while(!st.empty() && nums[st.top()]<=nums[i]){
                st.pop();
            }
            if(st.empty()){
                nge.push_back(n);
            }
            else{
                nge.push_back(st.top());
            }
            st.push(i);
        }
        reverse(nge.begin(),nge.end());
        for(int i =0;i<nums.size();i++){
            while(!st2.empty() && nums[st2.top()]<nums[i]){
                st2.pop();
            }
            if(st2.empty()){
                pge.push_back(-1);
            }
            else{
                pge.push_back(st2.top());
            }
            st2.push(i);
        }
        for(int i =0;i<nums.size();i++){
            while(!st3.empty() && nums[st3.top()]>nums[i]){
                st3.pop();
            }
            if(st3.empty()){
                pse.push_back(-1);
            }
            else{
                pse.push_back(st3.top());
            }
            st3.push(i);
        }
        for(int i =nums.size()-1;i>=0;i--){
            while(!st4.empty() && nums[st4.top()]>=nums[i]){
                st4.pop();
            }
            if(st4.empty()){
                nse.push_back(n);
            }
            else{
                nse.push_back(st4.top());
            }
            st4.push(i);
        }
        reverse(nse.begin(),nse.end());
        long long sum = 0;
        for(int i =0;i<nums.size();i++){
            long long maxCont = 1LL*nums[i]*(i-pge[i])*(nge[i]-i);
            long long minCont = 1LL*nums[i]*(i-pse[i])*(nse[i]-i);
            sum += maxCont-minCont;
        }
        return sum;
    }
};
