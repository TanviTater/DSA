// LeetCode ->1631. Path With Minimum Effort

using pii = pair<int,int>;
using piii = pair<int,pii>;
class Solution {
public:
    int minimumEffortPath(vector<vector<int>>& heights) {
        int m = heights.size();
        int n = heights[0].size();
        priority_queue<piii,vector<piii>,greater<piii>>pq;
        pq.push({0,{0,0}});
        vector<pii>dirs = {{0,1},{0,-1},{1,0},{-1,0}};
        vector<vector<int>>efforts(m,vector<int>(n,1e9));
        efforts[0][0] = 0;
        while(!pq.empty()){
            auto it = pq.top();
            pq.pop();
            int effort = it.first;
            int row = it.second.first;
            int col = it.second.second;
            if(row == m-1 && col == n-1) return effort;
            for(int i =0;i<4;i++){
                int newR = row+dirs[i].first;
                int newC = col+dirs[i].second;
                if(newR >= 0 && newC >= 0 && newR < m && newC < n){
                    int newEfforts = max(abs(heights[newR][newC] - heights[row][col]),effort);
                    if(newEfforts<efforts[newR][newC]){
                        efforts[newR][newC] = newEfforts;
                        pq.push({newEfforts,{newR,newC}});
                    }
                }
            }
        }
        return -1;
    }
};
