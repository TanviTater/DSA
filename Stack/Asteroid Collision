// LeetCode -> 735. Asteroid Collision
class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroid) {
        vector<int>ans;
        stack<int>st;
        for(int i =0;i<asteroid.size();i++){
            int curr = asteroid[i];
            while(!st.empty() && st.top()>0 && curr<0){
                if(st.top()<abs(curr)){
                    st.pop();
                }
                else if(st.top() == abs(curr)){
                    st.pop();
                    curr =0;
                }
                else{
                    curr = 0;
                }
            }
            if(curr != 0){
                st.push(curr);
            }
        }
        while(!st.empty()){
            ans.push_back(st.top());
            st.pop();
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
};
