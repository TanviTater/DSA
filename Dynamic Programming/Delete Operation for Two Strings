class Solution {
    int solveMem(string &text1,string &text2,int i,int j,vector<vector<int>>&dp){
        if(i == text1.size() || j == text2.size()) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        int incl = 0;
        if(text1[i] == text2[j]){
            incl = 1+solveMem(text1,text2,i+1,j+1,dp);
        }
        int excl1 = solveMem(text1,text2,i,j+1,dp);
        int excl2 = solveMem(text1,text2,i+1,j,dp);
        return dp[i][j] = max({incl,excl1,excl2});
    }
public:
    int minDistance(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();
        // vector<vector<int>>dp(n+1,vector<int>(m+1,-1));
        // int ans = solveMem(word1,word2,0,0,dp);
        // return word1.size()+word2.size()-(2*ans);
        vector<vector<int>>dp(n+1,vector<int>(m+1,0));
        for(int i = 1;i<=n;i++){
            for(int j = 1;j<=m;j++){
                if(word1[i-1] == word2[j-1]){
                    dp[i][j] = 1+dp[i-1][j-1];
                }
                else{
                    dp[i][j] = max(dp[i-1][j],dp[i][j-1]);
                }
            }
        }
        return word1.size()+word2.size()-(2*dp[n][m]);
    }
};
