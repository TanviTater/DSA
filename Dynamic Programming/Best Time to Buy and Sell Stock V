// LeetCode -> 3573. Best Time to Buy and Sell Stock V

class Solution {
public:
    long long solve(vector<int>&prices,int k,int buy,int i){
        if(i == prices.size() ){
            if(buy == 1){
                return 0;
            }
            else{
                return LLONG_MIN/2;
            }
        }
        if(i>=prices.size() || k<=0) return 0;
        long long profit = 0;
        if(buy == 1){
            profit = max({-prices[i] + solve(prices,k,0,i+1),solve(prices,k,1,i+1),+prices[i] + solve(prices,k,2,i+1)});
        }
        else if(buy == 0){
            profit = max(prices[i]+solve(prices,k-1,1,i+1),solve(prices,k,0,i+1));
        }
        else{
            profit = max(-prices[i] + solve(prices,k-1,1,i+1),solve(prices,k,2,i+1));
        }
        return profit;
    }
    long long solveMem(vector<int>&prices,int k,int buy,int i,vector<vector<vector<long long>>>&dp){
        if(i == prices.size()){
            if(buy == 1){
                return 0;
            }
            else{
                return LLONG_MIN/2;
            }
        }
        if(i>=prices.size() || k<=0) return 0;
        if(dp[k][buy][i] != -1) return dp[k][buy][i];
        long long profit = 0;
        if(buy == 1){
            profit = max({-prices[i] + solveMem(prices,k,0,i+1,dp),solveMem(prices,k,1,i+1,dp),+prices[i] + solveMem(prices,k,2,i+1,dp)});
        }
        else if(buy == 0){
            profit = max(prices[i]+solveMem(prices,k-1,1,i+1,dp),solveMem(prices,k,0,i+1,dp));
        }
        else{
            profit = max(-prices[i] + solveMem(prices,k-1,1,i+1,dp),solveMem(prices,k,2,i+1,dp));
        }
        return dp[k][buy][i] = profit;
    }
    long long maximumProfit(vector<int>& prices, int k) {
        // return solve(prices,k,1,0);
        int m = prices.size();
        vector<vector<vector<long long>>>dp(k+1,vector<vector<long long>>(4,vector<long long>(m+1,-1)));
        return solveMem(prices,k,1,0,dp);
    }
};
