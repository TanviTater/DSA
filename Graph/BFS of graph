// GeeksForGeeks -> BFS of graph

class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {
        int n =adj.size();
        vector<int>list;
        vector<bool>visited(n,false);
        queue<int>q;
        q.push(0);
        visited[0] = true;
        while(!q.empty()){
            int front = q.front();
            list.push_back(front);
            q.pop();
            for(auto it:adj[front]){
                if(!visited[it]){
                    q.push(it);
                    visited[it] = true;
                }
            }
        }
        return list;
    }
};
