// LeetCode ->1046. Last Stone Weight
class Solution {
public:
    int lastStoneWeight(vector<int>& stones) {
        priority_queue<int>pq;
        for(int i:stones){
            pq.push(i);
        }
        int diff = 0;
        int secTop = 0;
        while(pq.size()){
            int top = pq.top();
            pq.pop();
            if(!pq.empty()){
                secTop = pq.top();
                pq.pop();
            }
            else{
                return top;
            }
            diff = top - secTop;
            pq.push(diff);
        }
        return pq.top();
    }
};
