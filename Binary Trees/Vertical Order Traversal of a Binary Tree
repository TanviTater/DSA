// LeetCode -> 987. Vertical Order Traversal of a Binary Tree

class Solution {
public:
    vector<vector<int>> verticalTraversal(TreeNode* root) {
        if(root == NULL) return {{}};
        queue<pair<TreeNode*,pair<int,int>>>q;
        vector<pair<int,pair<int,int>>>v;
        vector<vector<int>>ans;
        q.push({root,{0,0}});
        v.push_back({0,{0,root->val}});
        while(!q.empty()){
            int n = q.size();
            for(int i=0;i<n;i++){
                TreeNode* front = q.front().first;
                int col = q.front().second.first;
                int row = q.front().second.second;
                q.pop();
                if(front->left){
                    q.push({front->left,{col-1,row+1}});
                    v.push_back({col-1,{row+1,front->left->val}});
                }
                if(front->right){
                    q.push({front->right,{col+1,row+1}});
                    v.push_back({col+1,{row+1,front->right->val}});
                }
            }
        }
        sort(v.begin(),v.end());
        int col = v[0].first;
        vector<int>temp;
        temp.push_back(v[0].second.second);
        for(int i =1;i<v.size();i++){
            if(col == v[i].first){
                temp.push_back(v[i].second.second);
            }
            else{
                ans.push_back(temp);
                temp.clear();
                temp.push_back(v[i].second.second);
            }
            col = v[i].first;
        }
        ans.push_back(temp);
        return ans;
    }
};
