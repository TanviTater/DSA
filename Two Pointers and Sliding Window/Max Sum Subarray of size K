// GeeksForGeeks -> Max Sum Subarray of size K

class Solution {
  public:
    int maxSubarraySum(vector<int>& nums, int k) {
      int left  =0;
      int right =0;
      int sum = 0;
      int maxSum =0;
      while(right<nums.size()){
          sum+=nums[right];
          while(right-left+1>k){
              sum-=nums[left];
              left++;
          }
          if(right-left+1==k){
              maxSum = max(maxSum,sum);
          }
          right++;
      }
      return maxSum;
    }
};
