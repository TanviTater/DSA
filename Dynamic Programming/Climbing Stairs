// LeetCode -> 70. Climbing Stairs

class Solution {
public:
int solve(int n){
    if(n<=2) return n;
    return solve(n-2)+solve(n-1);
}
int solveMem(int n ,vector<int>&dp){
    if(n<=2) return n;
    if(dp[n] != -1) return dp[n];
    return dp[n] = solveMem(n-2,dp)+solveMem(n-1,dp);
}
    int climbStairs(int n) {
        if(n <= 2) return n;
        // return solve(n);
        vector<int>dp(n+1,-1);
        // return solveMem(n,dp);

        vector<int>ways(n+1,0);
        ways[0] = 1;
        ways[1] = 1;
        for(int i =2;i<=n;i++){
            ways[i] = ways[i-1]+ways[i-2];
        }
        return ways[n];
    }
};
