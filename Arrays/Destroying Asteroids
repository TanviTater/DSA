// LeetCode -> 2126. Destroying Asteroids
class Solution {
public:
    bool asteroidsDestroyed(int mass, vector<int>& asteroids) {
        long long sum = mass;
        sort(asteroids.begin(), asteroids.end());
        for (int num : asteroids) {
            if (sum < num)
                return false;
            sum += num;
        }
        return true;
    }
};
