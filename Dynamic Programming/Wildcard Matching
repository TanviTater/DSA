// LeetCode -> 44. Wildcard Matching

using v = vector<int>;
using vv = vector<v>;
class Solution {
    bool solve(string &s,string &p,int i,int j){
        if(i<0 && j <0)return true;
        if(i>=0 && j<0) return false;
        if (i < 0) {
            for (int k = 0; k <= j; k++) {
                if (p[k] != '*')
                    return false;
            }
            return true;
        }
        bool ans = false;
        if(s[i] == p[j]){
            ans = solve(s,p,i-1,j-1);
        }
        else if(p[j] == '?'){
            ans = solve(s,p,i-1,j-1);
        }
        else if(p[j] == '*'){
            ans = solve(s,p,i-1,j) || solve(s,p,i,j-1);
        }
        return ans;
    }
    bool solveMem(string &s,string &p,int i,int j,vv&dp){
        if(i < 0 && j < 0)return true;
        if(i>=0 && j<0) return false;
        if (i < 0) {
            for (int k = 0; k <= j; k++) {
                if (p[k] != '*')
                    return false;
            }
            return true;
        }
        if(dp[i][j] != -1) return dp[i][j];
        bool ans = false;
        if(s[i] == p[j]){
            ans = solveMem(s,p,i-1,j-1,dp);
        }
        else if(p[j] == '?'){
            ans = solveMem(s,p,i-1,j-1,dp);
        }
        else if(p[j] == '*'){
            ans = solveMem(s,p,i-1,j,dp) || solveMem(s,p,i,j-1,dp);
        }
        return dp[i][j] =  ans;
    }
public:
    bool isMatch(string s, string p) {
        int n = s.size();
        int m = p.size();
        vv dp(n+1,v(m+1,-1));
        return solveMem(s,p,n-1,m-1,dp);
    }
};
