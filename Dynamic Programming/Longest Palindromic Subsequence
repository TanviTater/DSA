//LeetCode -> 516. Longest Palindromic Subsequence

class Solution {
    int lcsMem(string&s ,string& s2,int i,int j,vector<vector<int>>&dp){
        if(i<0 || j<0) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        if(s[i] == s2[j]){
            return dp[i][j] = 1+lcsMem(s,s2,i-1,j-1,dp);
        }
        else{
            return dp[i][j] = max(lcsMem(s,s2,i,j-1,dp),lcsMem(s,s2,i-1,j,dp));
        }
    }
    int lcsTab(string& s,string& s2){
        int m = s.size();
        int n = s2.size();
        vector<vector<int>>dp(m+1,vector<int>(n+1,-1));
        for(int i =0;i<=m;i++) dp[i][0] = 0;
        for(int j =0;j<=n;j++) dp[0][j] = 0;
        for(int i =1;i<=m;i++){
            for(int j = 1;j<=n;j++){
                if(s[i-1] == s2[j-1]){
                    dp[i][j] = 1+dp[i-1][j-1];
                }
                else{
                    dp[i][j] = max(dp[i][j-1],dp[i-1][j]);
                }
            }
        }
        return dp[m][n];
    }
public:
    int longestPalindromeSubseq(string s) {
        string s2 = s;
        int m = s2.size();
        reverse(s2.begin(), s2.end());
        vector<vector<int>>dp(m+1,vector<int>(m+1,-1));
        return lcsMem(s,s2,m-1,m-1,dp);
        // return lcsTab(s,s2);
    }
};
