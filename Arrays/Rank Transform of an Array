// LeetCode -> 1331. Rank Transform of an Array

class Solution {
public:
    vector<int> arrayRankTransform(vector<int>& arr) {
        if(arr.size() == 0) return {};
        vector<int>temp = arr;
        sort(temp.begin(),temp.end());
        vector<int>ans;
        unordered_map<int,int>v;
        v[temp[0]] = 1;
        int j =1;
        for(int i =1;i<temp.size();i++){
            if(temp[i] == temp[i-1]){
                v[temp[i]] = j;
            }
            else{
                j++;
                v[temp[i]] = j;
            }
        }
        for (int num : arr) {
            ans.push_back(v[num]);
        }
        return ans;
    }
};
