// LeetCode -> 2144. Minimum Cost of Buying Candies With Discount
class Solution {
public:
    int minimumCost(vector<int>& cost) {
        sort(cost.rbegin(),cost.rend());
        int costOfCandies = 0;
        for(int i = 0;i<cost.size();i++){
            if(i%3 != 2){
                costOfCandies+=cost[i];
            }
        }
        return costOfCandies;
    }
};
