// LeetCode -> 860. Lemonade Change

class Solution {
public:
    bool lemonadeChange(vector<int>& bills) {
        unordered_map<int,int>mp;
        for(int bill:bills){
            if(bill == 5){
                mp[5]++;
            }
            else if(bill == 10){
                if(mp[5] <= 0) return false;
                else{
                    mp[5]--;
                    mp[10]++;
                }
            }
            else{
                if((mp[10] < 1 || mp[5] < 1) && mp[5] < 3) return false;
                else{
                    if(mp[10]<1){
                        mp[5]-=3;
                    }
                    else{
                        mp[10]--;
                        mp[5]--;
                    }
                } 
            }
        }
        return true;
    }
};
