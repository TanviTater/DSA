// GeeksForGeeks -> Rat in a Maze
class Solution {
  public:
  void solve(vector<vector<int>>&maze,vector<string>&ans,string temp,int x,int y,vector<vector<int>>&visited){
      int n = maze.size();
      if(x == n-1 && y == n-1){
          ans.push_back(temp);
          return;
      }
        if(x-1>=0 && maze[x-1][y] == 1 && !visited[x-1][y]){
            temp.push_back('U');
            visited[x-1][y] = 1;
            solve(maze,ans,temp,x-1,y,visited);
            temp.pop_back();
            visited[x-1][y] = 0;
        }
        if(x+1<n && maze[x+1][y] == 1 && !visited[x+1][y]){
            temp.push_back('D');
            visited[x+1][y] =1;
            solve(maze,ans,temp,x+1,y,visited);
            temp.pop_back();
            visited[x+1][y] =0;
        }
        if(y-1>=0 && maze[x][y-1] == 1 && !visited[x][y-1]){
            temp.push_back('L');
            visited[x][y-1] = 1;
            solve(maze,ans,temp,x,y-1,visited);
            temp.pop_back();
            visited[x][y-1] = 0;
        }
        if(y+1<n && maze[x][y+1] == 1 && !visited[x][y+1]){
            temp.push_back('R');
            visited[x][y+1] = 1;
            solve(maze,ans,temp,x,y+1,visited);
            temp.pop_back();
            visited[x][y+1] = 0;
        }
          
  }
    vector<string> ratInMaze(vector<vector<int>>& maze) {
        // U -> x-1,y
        // D -> x+1,y
        // L -> x,y-1
        // R -> x,y+1
        vector<string>ans;
        int n = maze.size();
        string temp ="";
        vector<vector<int>>visited(n,vector<int>(n,0));
        visited[0][0] = 1;
        solve(maze,ans,temp,0,0,visited);
        sort(ans.begin(),ans.end());
        return ans;
    }
};
