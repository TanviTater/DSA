// LeetCode -> 416. Partition Equal Subset Sum

class Solution {
public:
    bool solve(vector<int>&nums,int i,int n,int target){
        if(i>=n) return false;
        if(target < 0) return false;
        if(target == 0) return true;
        int incl = solve(nums,i+1,n,target-nums[i]);
        int excl = solve(nums,i+1,n,target);
        return incl || excl;
    }
    bool solveMem(vector<int>&nums,int i,int n,int target,vector<vector<int>>&dp){
        if(i >= n) return false;
        if(target < 0) return false;
        if(target == 0) return true;
        if(dp[i][target] != -1) return dp[i][target];
        int incl = solveMem(nums,i+1,n,target-nums[i],dp);
        int excl = solveMem(nums,i+1,n,target,dp);
        return dp[i][target] = incl || excl;
    }
    bool canPartition(vector<int>& nums) {
        int totalSum = 0;
        int n =nums.size();
        for(int num : nums){
            totalSum += num;
        }
        if(totalSum % 2) return false;
        int eachSubsetSum = totalSum/2;
        // return solve(nums,0,n,eachSubsetSum);
        vector<vector<int>>dp(n+1,vector<int>(eachSubsetSum+1,-1));
        return solveMem(nums,0,n,eachSubsetSum,dp);
    }
};
