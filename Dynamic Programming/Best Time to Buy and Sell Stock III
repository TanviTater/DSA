// LeetCode -> 123. Best Time to Buy and Sell Stock III

class Solution {
public:
    int solve(vector<int>&prices,int i,int buy,int transaction){
        if(i>=prices.size() || transaction<=0) return 0;
        int profit = 0;
        if(buy){
            profit = max(-prices[i]+solve(prices,i+1,0,transaction),solve(prices,i+1,1,transaction));
        }
        else{
            profit = max(prices[i]+solve(prices,i+1,1,transaction-1),solve(prices,i+1,0,transaction));
        }
        return profit;
    }
    int solveMem(vector<int>&prices,int i ,int buy,int transaction,vector<vector<vector<int>>>&dp){
        if(i>=prices.size() || transaction <= 0) return 0;
        if(dp[i][buy][transaction] != -1) return dp[i][buy][transaction];
        int profit = 0;
        if(buy){
            profit = max(-prices[i]+solveMem(prices,i+1,0,transaction,dp),solveMem(prices,i+1,1,transaction,dp));
        }
        else{
            profit = max(prices[i] + solveMem(prices,i+1,1,transaction-1,dp),solveMem(prices,i+1,0,transaction,dp));
        }
        return dp[i][buy][transaction] = profit;
    }
    int maxProfit(vector<int>& prices) {
        // return solve(prices,0,1,2);
        int n = prices.size();
        vector<vector<vector<int>>>dp(n+1,vector<vector<int>>(2,vector<int>(3,-1)));
        return solveMem(prices,0,1,2,dp);
    }
};
