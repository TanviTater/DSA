// LeetCode -> 674. Longest Continuous Increasing Subsequence

// Can be solved just by maintaing two variable maxLen and currLen . No need of stack

class Solution {
public:
vector<int>getNGE(vector<int>&nums){
    vector<int>nge;
    stack<int>st;
    for(int i =nums.size()-1;i>=0;i--){
        while(!st.empty() && nums[st.top()]<=nums[i]){
            st.pop();
        }
        if(st.empty()){
            nge.push_back(-1);
        }
        else{
            nge.push_back(st.top());
        }
        st.push(i);
    }
    reverse(nge.begin(),nge.end());
    return nge;
}
    int findLengthOfLCIS(vector<int>& nums){
        vector<int>nge = getNGE(nums);
        for(int i :nge){
            cout<<i<<" ";
        }
        int maxLen = 1;
        int currLen = 1;
        for(int i = 0;i<nums.size();i++){
            if(nge[i] == i+1){
                currLen ++;
            }
            else{
                maxLen = max(maxLen,currLen);
                currLen =1;
            }
        }
        return maxLen;
    }
};
