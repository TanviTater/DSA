// LeetCode -> 36. Valid Sudoku
class Solution {
public:
bool isPossible(int r,int c,vector<vector<char>>& board,char val){
    int n = board.size();
    for(int i =0;i<n;i++){
        if(board[i][c] == val) return false;
    }
    for(int j = 0;j<n;j++){
        if(board[r][j] == val) return false;
    }
    for(int i =0;i<n;i++){
        int row = 3*(r/3)+i/3;
        int col = 3*(c/3)+i%3;
        if(board[row][col] == val) return false;
    }
    return true;
}
    bool isValidSudoku(vector<vector<char>>& board) {
        int n = board.size();
        for(int i =0;i<n;i++){
            for(int j =0;j<n;j++){
                if(board[i][j] == '.') continue;
                char val = board[i][j];
                board[i][j] = '.';
                if(!isPossible(i,j,board,val)){
                    return false;
                }
            }
        }
        return true;
    }
};
