// Leetcode ->79. Word Search
class Solution {
public:
bool solve(vector<vector<char>>&board,string word,int curr,vector<vector<int>>&visited,int i,int j){
    int m = board.size();
    int n = board[0].size();
    if(i>=m || j>=n) return false;
    if(curr == word.size()) return true;
    if(i-1>=0 && board[i-1][j] == word[curr] && !visited[i-1][j]){
        visited[i-1][j] = 1;
        if(solve(board,word,curr+1,visited,i-1,j)) return true;
        visited[i-1][j] = 0;
    }
    if(i+1<m && board[i+1][j] == word[curr] && !visited[i+1][j]){
        visited[i+1][j] = 1;
        if(solve(board,word,curr+1,visited,i+1,j)) return true;
        visited[i+1][j] = 0;
    }
    if(j-1>=0 && board[i][j-1] == word[curr] && !visited[i][j-1]){
        visited[i][j-1] = 1;
        if(solve(board,word,curr+1,visited,i,j-1)) return true;
        visited[i][j-1] = 0;
    }
    if(j+1<n && board[i][j+1] == word[curr] && !visited[i][j+1]){
        visited[i][j+1] = 1;
        if(solve(board,word,curr+1,visited,i,j+1)) return true;
        visited[i][j+1] = 0;
    }
    return false;
}
    bool exist(vector<vector<char>>& board, string word) {
        int m = board.size();
        int n = board[0].size();
        vector<vector<int>>visited(m,vector<int>(n,0));
        for(int i = 0;i<m;i++){
            for(int j =0;j<n;j++){
                if(board[i][j] == word[0]){
                    visited[i][j] =1;
                    if(solve(board,word,1,visited,i,j)) return true;
                    visited[i][j] =0;
                }
            }
        }
        return false;
    }
};
