// GeeksForGeeks -> Top View of Binary Tree

class Solution {
  public:
    vector<int> topView(Node *root) {
        // code here
        if(!root) return {};
        vector<int>ans;
        queue<pair<Node*,pair<int,int>>>q;
        vector<pair<int, pair<int, pair<int,int>>>> v;  // {col, {row, {index, value}}} 
        int idx =0;
        q.push({root,{0,0}});
        while(!q.empty()){
            Node* front = q.front().first;
            int col = q.front().second.first;
            int row = q.front().second.second;
            v.push_back({col,{row,{idx++,front->data}}});
            q.pop();
            if(front->left){
                q.push({front->left,{col-1,row+1}});
            }
            if(front->right){
                q.push({front->right,{col+1,row+1}});
            }
        }
        sort(v.begin(),v.end());
        int prevCol = v[0].first;
        ans.push_back(v[0].second.second.second);
        for(int i =1;i<v.size();i++){
            int col = v[i].first;
            if(col == prevCol) continue;
            else{
                ans.push_back(v[i].second.second.second);
                prevCol = col;
            }
        }
        return ans;
    }
};


