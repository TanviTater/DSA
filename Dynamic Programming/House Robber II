// LeetCode -> 213. House Robber II

class Solution {
public:
int solve(vector<int>&nums,int i,int n){
    if(n==i) return nums[n];
    if(n<i) return 0;
    int incl = nums[n]+solve(nums,i,n-2);
    int excl = solve(nums,i,n-1);
    return max(incl,excl);
}
int solveMem(vector<int>&nums,int i,int n,vector<int>&dp){
    if(n == i) return nums[n];
    if(n < i) return 0;
    if(dp[n] != -1) return dp[n];
    int incl = nums[n]+solveMem(nums,i,n-2,dp);
    int excl = solveMem(nums,i,n-1,dp);
    return dp[n] =  max(incl,excl);
}
    int rob(vector<int>& nums) {
        int n = nums.size()-1;
        // int ans1 = solve(nums,0,n-1);
        // int ans2 = solve(nums,1,n);
        if(nums.size() == 1) return nums[0];
        vector<int>dp1(n+1,-1);
        vector<int>dp2(n+1,-1);
        int ans1 = solveMem(nums,0,n-1,dp1);
        int ans2 = solveMem(nums,1,n,dp2);
        return max(ans1,ans2);
    }
};
